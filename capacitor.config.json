{
  "appId": "com.ammarmahdi.lisan",
  "appName": "Four Tongues",
  "webDir": "www",
  "backgroundColor": "#7A2F1F",
  "android": {
    "allowMixedContent": false
  },
  "ios": {
    "contentInset": "never"
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 3000,
      "launchAutoHide": true,
      "launchFadeOutDuration": 0,
      "backgroundColor": "#7A2F1F",
      "showSpinner": false
    },
    "LocalNotifications": {
      "smallIcon": "ic_stat_lisan",
      "iconColor": "#7A2F1F"
    }
  }
}
