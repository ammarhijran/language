{
  "appId": "com.ammarmahdi.lisan",
  "appName": "Lisan",
  "webDir": "www",
  "backgroundColor": "#faf7f2",
  "android": {
    "allowMixedContent": false
  },
  "ios": {
    "contentInset": "never"
  },
  "plugins": {
